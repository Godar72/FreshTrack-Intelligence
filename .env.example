# FreshTrack Intelligence - Environment Variables Configuration Template
# Academic Research Prototype (Store 1, Quito, Pichincha, Ecuador)
#
# NOTE: Secrets must NEVER be committed to version control.
# Copy this file to .env or .env.local for local customization.

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501

# Next.js Frontend Configuration
NEXT_PUBLIC_APP_NAME="FreshTrack Intelligence"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
BACKEND_API_URL="http://127.0.0.1:8000"

# Scikit-Learn Multiprocessing Optimization (Windows Loky fix)
LOKY_MAX_CPU_COUNT=4

# Production Deployment Placeholders (Configured on server/cloud only)
# AUTH_PROVIDER_URL=https://auth.example.com
# AUTH_CLIENT_ID=placeholder-client-id
# SENTRY_DSN=https://placeholder@sentry.io/123456
